  "entry": ".github/workflows/validate.yml",
  "permissions": {
    "allow": [],
    "elevated": [],
    "deny": []
  },
  "dependencies": {
    "bins": [],
    "env": []
  },
  "pricing_tier": "free",
  "tags": [
    "infra",
    "ci",
    "github-actions",
    "validation",
    "auto-release",
    "not-installable"
